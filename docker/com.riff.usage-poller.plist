<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Poll subscription usage into the running Riff server every few minutes.

  Install (edit the path first, or run from the repo root so $PWD resolves it):
    cp docker/com.riff.usage-poller.plist ~/Library/LaunchAgents/
    # set ProgramArguments' second string to the ABSOLUTE path of
    # docker/usage-poller.sh in your checkout, then:
    launchctl load ~/Library/LaunchAgents/com.riff.usage-poller.plist

  First run prompts for keychain access to "Claude Code-credentials"; choose
  Always Allow so the timer can read it unattended. Logs land in /tmp.
  Uninstall: launchctl unload ~/Library/LaunchAgents/com.riff.usage-poller.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.riff.usage-poller</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/ABSOLUTE/PATH/TO/riff/docker/usage-poller.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>180</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/riff-usage-poller.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/riff-usage-poller.err</string>
</dict>
</plist>
