{
  "name": "riff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Give it a company name and a CEO. It founds the company, and the CEO hires the rest.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clafollett/riff.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "node scripts/check-sfc-types.mjs && tsgo --noEmit && tsgo --noEmit -p desk/tsconfig.json && tsgo --noEmit -p e2e/tsconfig.json",
    "test": "node --test test/**/*.test.ts",
    "desk": "node src/gateway/server.ts",
    "desk:build": "vite build --config desk/vite.config.ts",
    "desk:dev": "vite --config desk/vite.config.ts",
    "test:ui": "npm run desk:build && playwright test",
    "mcp": "node src/mcp/server.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-vue": "^6.0.8",
    "ts5": "npm:typescript@5.9.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.243",
    "markdown-it": "^15.0.0",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  }
}
